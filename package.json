{
  "name": "sistem-surat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./public/system/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.sistemsurat.app",
    "productName": "Sistem Surat",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "public/system/**/*"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "docxtemplater": "^3.69.3",
    "docxtemplater-image-module-free": "^1.1.1",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.8.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.7",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.11",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
